# ── FreeRouter 网关 ──────────────────────────────────────────────
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm-database:latest
FREEROUTER_PORT=4000
LITELLM_MASTER_KEY=CHANGE_ME_MASTER_KEY
LITELLM_SALT_KEY=CHANGE_ME_SALT_KEY
LITELLM_DISABLE_NO_REDIS_WARNING=true
STORE_MODEL_IN_DB=True

# ── 自动刷新与自愈 ───────────────────────────────────────────────
# 刷新间隔（秒），默认 6 小时；最小 300
FREEROUTER_REFRESH_INTERVAL=21600
# 健康模型多久没有成功记录才主动探测一次（小时）。
# 真实调用会持续验证模型，所以有流量时这条基本不触发。
FREEROUTER_RECHECK_HOURS=24
# 连续失败几次后把模型移出 free-router 池
FREEROUTER_FAILURE_THRESHOLD=3
# 限时活动到期前多少天开始提醒
FREEROUTER_OFFER_WARN_DAYS=14
# 模型池变化时推送到这个 webhook（飞书 / 企业微信 / 钉钉 / Slack / Discord / 通用 JSON 均可）
FREEROUTER_NOTIFY_WEBHOOK=

# ── 平台 API Key（填一个就能跑，留空的平台自动跳过）──────────────
# ── BEGIN GENERATED: provider-keys — 由 make docs 生成，请勿手改 ──

# ── 永久免费层（长期可用） ──

# Cerebras：Llama、Qwen 等高速推理
#   注册领 Key: https://cloud.cerebras.ai/platform/apikeys
CEREBRAS_API_KEY=

# Cloudflare Workers AI：Llama、Qwen、Mistral 等 50+ 模型
#   注册领 Key: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Cohere：Command 系列（仅限非商业用途）
#   注册领 Key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Google AI Studio (Gemini)：Gemini Flash 与 Gemma 系列
#   注册领 Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq：Llama、Qwen 等全系模型，LPU 超高速推理
#   注册领 Key: https://console.groq.com/keys
GROQ_API_KEY=

# Mistral AI：Mistral Small/Large、Codestral 等全系文本模型
#   注册领 Key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# 魔搭社区 ModelScope：Qwen3、DeepSeek、GLM 等 25 个开源模型免费推理
#   注册领 Key: https://modelscope.cn/register?inviteCode=MarkWave&invitorName=MarkWave（邀请链接，双方都有奖励）
MODELSCOPE_API_KEY=

# NVIDIA NIM：Llama、Gemma、Mistral 等 100+ 开源模型
#   注册领 Key: https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY=

# OpenRouter：20+ 个 :free 后缀模型，DeepSeek/Gemma/Nemotron 等
#   注册领 Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 百度千帆：ERNIE Speed / Lite / Tiny 永久免费不限量
#   注册领 Key: https://console.bce.baidu.com/iam/#/iam/apikey/list
QIANFAN_API_KEY=

# 硅基流动 SiliconFlow：Qwen3-8B、GLM-4-9B 等 9B 以下开源模型永久免费
#   注册领 Key: https://cloud.siliconflow.cn/i/CuI9M5Ht（邀请链接，双方都有奖励）
SILICONFLOW_API_KEY=

# ZenMux：自动发现平台上所有 0 价模型
#   注册领 Key: https://zenmux.ai/invite/L4QDZW（邀请链接，双方都有奖励）
ZENMUX_API_KEY=

# 智谱 AI (BigModel)：GLM-4.7-Flash 等 Flash 系列长期免费
