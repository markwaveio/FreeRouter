ZHIPU_API_KEY=

# ── 新用户赠送额度（有有效期） ──

# 阿里云百炼 (DashScope)：通义千问 Qwen-Turbo / Plus / Flash
#   注册领 Key: https://bailian.console.aliyun.com/?tab=model#/api-key
DASHSCOPE_API_KEY=

