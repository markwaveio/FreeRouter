# 你自己在 config/litellm-config.yaml 里挂的付费模型
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 本地数据库 ───────────────────────────────────────────────────
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
